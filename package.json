{
  "name": "thenewpractice-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --ignore-pattern coverage/ --ignore-pattern playwright-report/ --ignore-pattern .lighthouseci/",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "e2e:route": "playwright test --grep",
    "e2e:ui": "playwright test --ui",
    "lighthouse": "node tests/lighthouse/run.mjs",
    "content:check": "node --experimental-strip-types scripts/check-content.ts",
    "assets": "node scripts/prepare-assets.mjs",
    "video": "node scripts/prepare-video.mjs",
    "media": "npm run video && npm run assets",
    "verify": "npm run lint && npm run typecheck && npm run test:coverage && npm run build"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@react-three/fiber": "9.7.0",
    "@shadergradient/react": "2.4.20",
    "camera-controls": "3.1.2",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "motion": "^13.3.0",
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.88.0",
    "three": "0.186.0",
    "three-stdlib": "2.36.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "0.186.0",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "sharp": "^0.35.4",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.2.7"
  }
}
