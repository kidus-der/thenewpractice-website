# Copy to .env.local for development. Validated at startup by src/lib/env.ts;
# an invalid value fails the build with the offending variable named.

# Which deployment this is: development | staging | production. Only
# `production` is indexable; anything else serves noindex and a disallow-all robots.txt.
SITE_ENV=development

# Public origin of this deployment, no trailing slash. Used for metadataBase,
# canonical URLs, Open Graph and the sitemap URL in robots.txt.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Email (task 15, round 1 R6). Every enquiry and every self-assessment a visitor
# chooses to send becomes one branded email to ENQUIRY_TO_EMAIL. The steps to
# provision it on the practice's own Vercel account are in docs/EMAIL-SETUP.md.
# `npm run email:preview` renders the emails locally without sending anything.

# Resend API key, added by the Resend Marketplace integration. Leave unset to
# log a line of non-personal facts to stdout instead of sending.
RESEND_API_KEY=

# The practice's inbox: receives enquiries and self-assessments when
# RESEND_API_KEY is set.
ENQUIRY_TO_EMAIL=

# Optional. Sending address on the domain verified in Resend. Defaults to
# enquiries@<host of NEXT_PUBLIC_SITE_URL>; set this when that host is not the
# verified domain (previews, a verified subdomain such as mail.<domain>).
ENQUIRY_FROM_EMAIL=
