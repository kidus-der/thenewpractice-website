# Copy to .env.local for development. Validated at startup by src/lib/env.ts;
# an invalid value fails the build with the offending variable named.

# Which deployment this is: development | staging | production. Only
# `production` is indexable; anything else serves noindex and a disallow-all robots.txt.
SITE_ENV=development

# Public origin of this deployment, no trailing slash. Used for metadataBase,
# canonical URLs, Open Graph and the sitemap URL in robots.txt.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Resend API key for the enquiry form's mail adapter (task 15). Leave unset to
# log enquiries to stdout instead of sending.
RESEND_API_KEY=

# Mailbox that receives enquiries when RESEND_API_KEY is set (task 15).
ENQUIRY_TO_EMAIL=

# Optional. Verified sending address for enquiry emails (task 15). Defaults to
# enquiries@<host of NEXT_PUBLIC_SITE_URL>; set this when that host is not a
# verified Resend domain (staging, previews).
ENQUIRY_FROM_EMAIL=
